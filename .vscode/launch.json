{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "01-smart-ptrs",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/01-smart-ptrs/01SmartPtrs",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
